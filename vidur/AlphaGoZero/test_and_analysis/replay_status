#!/usr/bin/env python3
"""Simple AlphaGoZero replay_buffer.csv status reader.

Reads only the latest row from:
- workers: <output_root>/worker_large/<worker_id>/replay_buffer.csv
- XL:      <output_root>/replay_buffer.csv
"""

from __future__ import annotations

import argparse
import csv
import json
import subprocess
import sys
from pathlib import Path
from typing import Any

REPO_ROOT = Path(__file__).resolve().parents[3]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from vidur.AlphaGoZero.cluster import REMOTE_OUTPUT_ROOT, WORKERS, XL, parse_workers  # noqa: E402

WORKER_FIELDS = [
    "states_generated",
    "controller_states",
    "adversary_states",
    "games_executed_so_far",
    "model_iteration_version",
    "time_24h",
]
XL_FIELDS = [
    "states_produced",
    "controller_states",
    "adversary_states",
    "remaining_buffer_size",
    "time_24h",
    "time_since_last_10k_states_24h",
]


def ssh_tail(host: str, path: str, timeout: int) -> tuple[int, str]:
    cmd = [
        "ssh",
        "-o", "BatchMode=yes",
        "-o", f"ConnectTimeout={max(1, min(timeout, 30))}",
        host,
        f"tail -n 1 {path} 2>/dev/null || true",
    ]
    try:
        cp = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout, check=False)
        return int(cp.returncode), (cp.stdout or "").strip()
    except subprocess.TimeoutExpired:
        return 124, f"TIMEOUT after {timeout}s"


def parse_row(line: str, fields: list[str]) -> dict[str, str]:
    if not line or line == ",".join(fields) or line.startswith("TIMEOUT"):
        return {}
    rows = list(csv.DictReader([",".join(fields), line]))
    return dict(rows[0]) if rows else {}


def fmt(value: Any) -> str:
    return "" if value is None else str(value)


def print_table(rows: list[dict[str, Any]], columns: list[tuple[str, str]]) -> None:
    widths = [max(len(label), *(len(fmt(row.get(key, ""))) for row in rows)) for key, label in columns]
    print("  ".join(label.ljust(widths[i]) for i, (_, label) in enumerate(columns)))
    print("  ".join("-" * w for w in widths))
    for row in rows:
        print("  ".join(fmt(row.get(key, "")).ljust(widths[i]) for i, (key, _) in enumerate(columns)))


def worker_status(worker, output_root: str, mode: str, timeout: int) -> dict[str, Any]:
    path = f"{output_root.rstrip('/')}/worker_{mode}/{worker.worker_id}/replay_buffer.csv"
    rc, line = ssh_tail(worker.host, path, timeout)
    row = parse_row(line, WORKER_FIELDS)
    return {
        "worker": worker.worker_id,
        "host": worker.host,
        "states": row.get("states_generated", "0"),
        "controller": row.get("controller_states", "0"),
        "adversary": row.get("adversary_states", "0"),
        "games": row.get("games_executed_so_far", "0"),
        "model": row.get("model_iteration_version", ""),
        "time": row.get("time_24h", ""),
        "error": "" if rc == 0 and not line.startswith("TIMEOUT") else line,
    }


def xl_status(output_root: str, timeout: int) -> dict[str, Any]:
    path = f"{output_root.rstrip('/')}/replay_buffer.csv"
    rc, line = ssh_tail(XL.host, path, timeout)
    row = parse_row(line, XL_FIELDS)
    return {
        "host": XL.host,
        "states": row.get("states_produced", "0"),
        "controller": row.get("controller_states", "0"),
        "adversary": row.get("adversary_states", "0"),
        "remaining": row.get("remaining_buffer_size", ""),
        "time": row.get("time_24h", ""),
        "last_10k": row.get("time_since_last_10k_states_24h", ""),
        "error": "" if rc == 0 and not line.startswith("TIMEOUT") else line,
    }


def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(description="Read latest AlphaGoZero replay_buffer.csv rows from workers and XL.")
    p.add_argument("--workers", default="all")
    p.add_argument("--output-root", default=REMOTE_OUTPUT_ROOT)
    p.add_argument("--mode", choices=("large", "smoke"), default="large")
    p.add_argument("--timeout", type=int, default=10)
    p.add_argument("--json", action="store_true")
    return p.parse_args()


def main() -> None:
    args = parse_args()
    workers = [worker_status(w, args.output_root, args.mode, int(args.timeout)) for w in parse_workers(args.workers)]
    xl = xl_status(args.output_root, int(args.timeout))
    if args.json:
        print(json.dumps({"xl": xl, "workers": workers}, indent=2, sort_keys=True))
        return

    print("Classical XL replay_buffer.csv")
    print_table([xl], [
        ("host", "host"),
        ("states", "states"),
        ("controller", "ctrl"),
        ("adversary", "adv"),
        ("remaining", "remaining"),
        ("time", "time"),
        ("last_10k", "last_10k"),
    ])
    if xl.get("error"):
        print(f"XL error: {xl['error']}")

    print("\nWorker replay_buffer.csv")
    print_table(workers, [
        ("worker", "worker"),
        ("host", "host"),
        ("states", "states"),
        ("controller", "ctrl"),
        ("adversary", "adv"),
        ("games", "games"),
        ("model", "model"),
        ("time", "time"),
    ])
    for row in workers:
        if row.get("error"):
            print(f"{row['worker']} error: {row['error']}")


if __name__ == "__main__":
    main()
